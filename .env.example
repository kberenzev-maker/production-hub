# ==============================================================================
# Production Hub — Шаблон конфигурации окружения (.env.example)
# Скопируйте этот файл в .env и укажите ваши значения: cp .env.example .env
# ==============================================================================

# 1. Токен Telegram-бота (ОБЯЗАТЕЛЬНО для боевого режима)
# Получить в @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 2. URL приложения / Mini App
# Локально: http://localhost:3000
# Для мобильного Telegram: https://your-domain.com или https://xxxx.ngrok-free.app
APP_URL="http://localhost:3000"

# 3. Google Gemini API Key (Опционально, для AI-транскрибации войсов)
# Получить: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 4. Порт локального сервера
PORT=3000
